# Configuración del backend (copia este archivo como ".env" en la raíz)
# Nunca subas este archivo con valores reales a Git.

# demo | openai | anthropic
AI_PROVIDER=demo

# Solo si AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Solo si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Parámetros del agente (temperatura baja y límites para llamadas)
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=20
AGENT_MAX_STEPS=6
AGENT_MAX_RETRIES=1
AGENT_RETRY_DELAY_SECONDS=0.2
AGENT_TOOL_TIMEOUT_SECONDS=10

# CORS restrictivo
FRONTEND_ORIGIN=http://localhost:3000
