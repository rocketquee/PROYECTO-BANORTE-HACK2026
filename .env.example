# Configuración del backend (copia este archivo como ".env" en la raíz)
# Nunca subas este archivo con valores reales a Git.

# demo | openai | anthropic
AI_PROVIDER=demo

# Solo si AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Solo si AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Parámetros del agente (temperatura baja y límites para llamadas)
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=20
AGENT_MAX_STEPS=6
AGENT_MAX_RETRIES=1
AGENT_RETRY_DELAY_SECONDS=0.2
AGENT_TOOL_TIMEOUT_SECONDS=10

# CORS restrictivo
FRONTEND_ORIGIN=http://localhost:3000

# Despliegue público: exige autenticación de administrador único.
# En local se puede dejar desactivado; BANORTE_PUBLIC=1 sin auth impide arrancar.
BANORTE_PUBLIC=0
BANORTE_AUTH_ENABLED=0
BANORTE_ADMIN_USER=admin
# Genera el hash con: cd backend && ..\.venv\Scripts\python -m app.core.auth
BANORTE_ADMIN_PASSWORD_HASH=
# Secreto de firma de cookies; mínimo 32 caracteres.
BANORTE_SESSION_SECRET=
BANORTE_COOKIE_SECURE=0
# Opcional: dominio compartido entre frontend y API (p. ej. .example.com).
BANORTE_COOKIE_DOMAIN=
BANORTE_SESSION_TTL_SECONDS=43200
